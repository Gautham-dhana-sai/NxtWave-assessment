# Copy this file to .env and fill in the secrets before running docker compose up
PORT=3000

# --- local dev (overridden by docker-compose for containerised run) ---
MONGODB_URI=mongodb://localhost:27017/tasktracker
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60

# --- JWT (required) ---
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
